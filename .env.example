NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BASE_DOMAIN=localhost

# === Tiempo real (tareas y avisos) ===
# Se usan SOLO para abrir el canal privado de la organización por WebSocket, que
# avisa qué cambió. El frontend no consulta tablas, RPC ni Storage con esto: los
# datos los sigue pidiendo al backend. La publishable key es pública por diseño.
# Sin estas variables la app funciona igual, pero sin actualización en vivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# === Integración Club Plaza (carga masiva de jugadores) ===
# SOLO de servidor, sin prefijo NEXT_PUBLIC_. Se leen en app/api/clubplaza/**.
# Staging: https://club-plaza-staging-770033413431.us-central1.run.app/api/v1
CLUBPLAZA_API_URL=http://localhost:3001/api/v1
CLUBPLAZA_USUARIO=
CLUBPLAZA_PASSWORD=
CLUBPLAZA_CLUB_ID=

# === Gesti con IA (Claude) ===
# SOLO de servidor, sin prefijo NEXT_PUBLIC_. Se leen en server/modules/gesti.
# Clave de la API de Anthropic. Sin ella Gesti responde que todavía no está
# activada y el resto de la app funciona igual.
ANTHROPIC_API_KEY=
# Opcional (100 si no se define). El tope real es el límite de gasto de la API
# key en la consola de Anthropic; este valor solo alimenta el panel de consumo y
# el aviso anticipado. Al llegar a cualquiera de los dos, Gesti avisa con un
# mensaje normal (sin error) hasta el 1 del mes siguiente.
# GESTI_MONTHLY_BUDGET_USD=100
