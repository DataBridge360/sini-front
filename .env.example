NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BASE_DOMAIN=localhost

# === Tiempo real (tareas y avisos) ===
# Se usan SOLO para abrir el canal privado de la organización por WebSocket, que
# avisa qué cambió. El frontend no consulta tablas, RPC ni Storage con esto: los
# datos los sigue pidiendo al backend. La publishable key es pública por diseño.
# Sin estas variables la app funciona igual, pero sin actualización en vivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# === Integración Club Plaza (carga masiva de jugadores) ===
# SOLO de servidor, sin prefijo NEXT_PUBLIC_. Se leen en app/api/clubplaza/**.
# Staging: https://club-plaza-staging-770033413431.us-central1.run.app/api/v1
CLUBPLAZA_API_URL=http://localhost:3001/api/v1
CLUBPLAZA_USUARIO=
CLUBPLAZA_PASSWORD=
CLUBPLAZA_CLUB_ID=
